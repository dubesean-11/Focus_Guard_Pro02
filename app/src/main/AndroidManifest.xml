<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Device Admin (for uninstall protection) -->
    <uses-permission android:name="android.permission.BIND_DEVICE_ADMIN" />

    <!-- UsageStats (for app monitoring) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".FocusGuardApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FocusGuardPro"
        tools:targetApi="31">

        <!-- Splash / Entry point -->
        <activity
            android:name=".ui.onboarding.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.FocusGuardPro.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Role Selection (first launch) -->
        <activity
            android:name=".ui.onboarding.RoleSelectionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Parent Onboarding -->
        <activity
            android:name=".ui.onboarding.ParentOnboardingActivity"
            android:exported="false" />

        <!-- Child Onboarding -->
        <activity
            android:name=".ui.onboarding.ChildOnboardingActivity"
            android:exported="false" />

        <!-- Parent Dashboard (main parent screen) -->
        <activity
            android:name=".ui.parent.ParentDashboardActivity"
            android:exported="false" />

        <!-- Child Dashboard (main child screen) -->
        <activity
            android:name=".ui.child.ChildDashboardActivity"
            android:exported="false" />

        <!-- PIN Entry (shared) -->
        <activity
            android:name=".ui.common.PinActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- AppLock Service (foreground) -->
        <service
            android:name=".service.AppLockService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            tools:targetApi="34" />

        <!-- Boot receiver (restart service on reboot) -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Device Admin Receiver (uninstall protection stub) -->
        <receiver
            android:name=".receiver.FocusDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
