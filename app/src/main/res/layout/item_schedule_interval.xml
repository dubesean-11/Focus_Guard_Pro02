<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/spacing_md"
    android:paddingEnd="@dimen/spacing_md"
    android:paddingTop="@dimen/spacing_sm"
    android:paddingBottom="@dimen/spacing_sm"
    android:background="?attr/selectableItemBackground">

    <!-- Color indicator -->
    <View
        android:id="@+id/viewTypeIndicator"
        android:layout_width="4dp"
        android:layout_height="48dp"
        android:layout_marginEnd="@dimen/spacing_md"
        android:background="@color/schedule_block_color" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvIntervalType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Study"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_size_subtitle"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvIntervalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="09:00 – 10:30"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_size_body" />

    </LinearLayout>

    <!-- Delete button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDeleteInterval"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Remove"
        style="@style/Widget.Material3.Button.TextButton" />

</LinearLayout>
